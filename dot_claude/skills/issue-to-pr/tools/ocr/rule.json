{
  "include": [
    "**/*_test.go",
    "**/src/test/java/**/*.java",
    "**/src/test/**/*.{kt,kts}",
    "**/*Test.fs",
    "**/*.test.{js,jsx,ts,tsx}",
    "**/*.spec.{js,jsx,ts,tsx}",
    "**/__tests__/**/*.{js,jsx,ts,tsx,mjs,cjs}",
    "**/test/**/*_test.py",
    "**/tests/**/*_test.py",
    "**/*_test.py",
    "**/test_*.py",
    "**/*_spec.rb",
    "**/spec/**/*_spec.rb",
    "**/*Test.java",
    "**/*Tests.java",
    "**/*_test.rs",
    "**/*.test.ets",
    "**/test/**/*.jl",
    "**/test/**/*.hs",
    "**/*Spec.hs",
    "**/test/**/*.lhs",
    "**/*Spec.lhs",
    "**/tests/**/*.nim",
    "**/tests/**/*.R",
    "**/*Test.swift",
    "**/*Tests.swift",
    "**/Tests/**/*.swift",
    "**/tests/**/*.elm",
    "**/test/**/*.zig",
    "**/*_test.zig",
    "**/test/**/*.ml",
    "**/tb_*.{v,sv,vhd,vhdl}",
    "**/*_tb.{v,sv,vhd,vhdl}",
    "**/*.t.sol",
    "**/test/**/*.sol",
    "**/tests/**/*.sol",
    "**/test/**/*.vy",
    "**/tests/**/*.vy"
