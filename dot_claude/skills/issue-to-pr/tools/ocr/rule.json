    "**/dist/**",
    "**/.next/**",
    "**/.nuxt/**",
    "**/.svelte-kit/**",
    "**/.astro/**",
    "**/.turbo/**",
    "**/.angular/**",
    "**/.parcel-cache/**",
    "**/.docusaurus/**",
    "**/vendor/**",
    "**/.bundle/**",
    "**/target/**",
    "**/.gradle/**",
    "**/__pycache__/**",
    "**/.venv/**",
    "**/venv/**",
    "**/site-packages/**",
    "**/*.egg-info/**",
    "**/.tox/**",
    "**/.mypy_cache/**",
    "**/.pytest_cache/**",
    "**/.ruff_cache/**",
    "**/Pods/**",
    "**/Carthage/**",
    "**/.build/**",
    "**/obj/**",
    "**/.dart_tool/**",
    "**/.terraform/**",
    "**/.stack-work/**",
    "**/coverage/lcov-report/**"
