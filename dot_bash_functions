#!/usr/bin/env bash
# i create a lot of tar backups before i do things :)

function backup() {
    if [ -z "$1" ]; then
        echo "Usage: backup DIRECTORY"
    else
        DIR="$( (cd "$1" && pwd) )"
        if [ $? -eq 0 ]; then
            local dirname date
            dirname=$(basename "${DIR}")
            date=$(date +%Y%m%d-%H%M%S)
            local tarball="${dirname}.${date}.tar.gz"
            echo "Backing up ${1} to ${tarball}"
            echo ""
            tar -zcvf "${tarball}" "${1}"
        else
            echo "Unable to backup $1. Does it exist?"
        fi
    fi
}

function bak() {
    cp "$1" "${1}_$(date +%Y%m%d-%H%M%S)"
}

function calc() {
    echo "$*" | bc;
}

# https://unix.stackexchange.com/questions/6/what-are-your-favorite-command-line-features-or-tricks/122#122
function cd() {
    builtin cd "$@" && ls
}

function cdf {
    local dir
    dir=$(find . -name "$1" -type f | head -1 | xargs dirname 2>/dev/null)
    [[ -n "$dir" ]] || return
    cd -- "$dir" || return
}

# https://github.com/michaelkitson/dotfiles/blob/master/bash_functions
function define() {
    curl -s "www.thefreedictionary.com/$1" | \grep -Eo '<div class="pseg">.*?<hr>' | sed 's/<div class="pseg">//' | sed -E 's/<div class="etyseg">.*//' | sed 's/<script>.*<\/script>//g' | sed -E 's/<div[^>]*>/@/g' | tr '@' '\n' | sed 's/<[^>]*>//g' | sed 's/^[a-z]\.  /    /g'
}

# https://github.com/necolas/dotfiles/blob/master/shell/functions/datauri
function datauri() {
    local mimeType
    mimeType=$(file -b --mime-type "$1")
    if [[ $mimeType == text/* ]]; then
        mimeType="${mimeType};charset=utf-8"
    fi
    printf '%s' "data:${mimeType};base64,$(openssl base64 -in "$1" | tr -d '\n')" | pbcopy && printf "=> data URI copied to pasteboard.\n"
}

function dirty_repos() {
    while IFS= read -r repo; do
        local base
        base=$(dirname "$repo")
        pushd "$base" > /dev/null || continue
        [ -z "$(git status --porcelain --untracked-files=no)" ] || echo "Repository $base contains differences."
        popd > /dev/null || return
    done < <(find . -maxdepth 10 -name .git)
}

function ed() {
    find  . -type d -empty
}

function ef() {
    find  . -type f -empty
}

# https://github.com/anthonypdawson/dotfiles/blob/master/bash_functions
function ex() {
    if [ -f "$1" ]; then
        case "$1" in
            *.tar.bz2)   tar xjf "$1"   ;;
            *.tar.gz)    tar xzf "$1"   ;;
            *.bz2)       bunzip2 "$1"   ;;
            *.rar)       rar x "$1"     ;;
            *.gz)        gunzip "$1"    ;;
            *.tar)       tar xf "$1"    ;;
            *.tbz2)      tar xjf "$1"   ;;
            *.tgz)       tar xzf "$1"   ;;
            *.zip)       unzip "$1"     ;;
            *.Z)         uncompress "$1";;
            *.7z)        7z x "$1"      ;;
            *)           echo "'$1' cannot be extracted via ex()" ;;
        esac
    else
        echo "'$1' is not a valid file"
    fi
}

# find a file
function ff() {
    find . -type f -iname "*${1}*" -ls;
}

# find and execute
function fe() {
    find . -type f -iname "*${1:-}*" -exec "${2:-file}" {} \;
}

function fzf_log() {
    local hash
    hash=$(git log --format="%h%d %s %cr" "$@" |  fzf | awk '{print $1}')
    echo $hash | pbcopy;
    git showtool $hash
}

function gi() {
    local IFS=,
    curl -sL "https://www.toptal.com/developers/gitignore/api/$*"
}

function keel() {
    sudo pkill -9 -f "$1"
}

function lcm() {
    local last_commit
    last_commit=$(git log -1 --format="%H")

    local last_commit_message
    last_commit_message=$(git log -1 --pretty=%B)

    echo -e "Checked into commit: ${last_commit}\n\n${last_commit_message}" | pbcopy
}

function matrix() {
    LC_ALL=C tr -c "[:print:]" " " < /dev/urandom | dd cbs=$COLUMNS conv=unblock | GREP_COLOR="1;32" grep --color "[^ ]"
}

function members() {
    cat /etc/group | grep --regex "^$1:.*" | cut -d: -f4
}

function mkcd() {
    mkdir -p "$1"
    cd "$1" || return
}

function newrepo() {
    if [ -d $1 ]; then
        echo "Directory with identical name as repo exists. Please create in another folder."
    else
        mkdir $1
        pushd . > /dev/null
        cd "$1" || return
        touch README.md
        git init
        git add README.md
        git commit -m "first commit"
        git remote add origin git@github.com:${USER}/$1.git
        git push -u origin main
        popd > /dev/null || return
    fi
}

function port() {
    lsof -i:$1
}

function port_clean() {
    sudo /opt/local/bin/port -f clean --all all && sudo /opt/local/bin/port -f uninstall inactive
}

function prompt_yes_no() {
    read -r -p "$* [y/N] " ans
    case "$ans" in
        y|Y|yes|Yes) return 0;;
        *) return 1;;
    esac
}

function pyjson() {
    local output
    output=$(python3 -c "import json, sys; print(json.dumps(json.loads(sys.stdin.read()), sort_keys=True, indent=2))")
    if command -v pygmentize >/dev/null 2>/dev/null; then
        echo "$output" | pygmentize -l javascript
    else
        echo "$output"
    fi
}

# https://github.com/necolas/dotfiles/blob/master/shell/functions/pyserver
function pyserver() {
    local port="${1:-8000}"
    [[ "$OSTYPE" == darwin* ]] && open "http://localhost:${port}/"
    python -m http.server "$port"
}

function rglogs() { rg --sortr created "$@" ~/.logs/; }

# scan local network
function scan() {
    if [ -z "$1" ]; then
        echo "Usage: scan CIDR"
    else
        if command -v nmap >/dev/null 2>&1; then
            nmap -sn "$@" -oG - | awk '$4=="Status:" && $5=="Up" {print $2, $3}'
        else
            echo "Nmap is not installed. Please install and try again."
        fi
    fi
}

# share a file on 8080 using netcat, just redirect (e.g. share < file.txt)
function share() {
    sudo nc -v -l "${1:-8080}"
}

function tm() {
  local new_session="${1:-new}"
  local session
  session=$(tmux list-sessions -F "#{session_name}" 2>/dev/null | fzf --query="$1" --select-1 --exit-0)
  if [[ -n "$TMUX" ]]; then
    [[ -z "$session" ]] && echo "tm: no matching session" >&2 && return 1
    tmux switch-client -t "$session"
  else
    if [[ -z "$session" ]]; then
      tmux new-session -s "$new_session"
    else
      tmux attach-session -t "$session"
    fi
  fi
}

function _tm_sessions () {
    local cur
    COMPREPLY=()
    cur="${COMP_WORDS[COMP_CWORD]}"
    mapfile -t COMPREPLY < <(compgen -W "$(tmux list-sessions -F '#{session_name}' | cut -d' ' -f1)" -- "${cur}")
    return 0
}

complete -F _tm_sessions tm

function tmk() {
    if [ -n "$1" ]; then
        tmux kill-session -t $1 2>/dev/null
    else
        echo "Please pass in a named tmux session to kill."
    fi
}

function used() {
    local n="${1:-20}"
    local depth="${2:-1}"
    command du -h -d "${depth}" .[!.]* * 2>/dev/null | awk -F'\t' '{paths[NR]=$2; lines[NR]=$0} END {for(i=1;i<=NR;i++){p=1; for(j=1;j<=NR;j++){if(i!=j && index(paths[j],paths[i]"/")==1){p=0;break}} if(p)print lines[i]}}' | (command -v gsort &>/dev/null && gsort -hr || sort -hr) | head -n "${n}"
}

# not sure where i found this one, but queries wikipedia
function wiki() {
    dig +short txt $1.wp.dg.cx;
}

# helpers
function fn_exists() {
    command -v $1 >/dev/null 2>&1
    return $?
}

# workmux worktree from a GitHub issue or PR number: wmg 123
function wmg() {
    local n="${1#\#}"
    if [ -z "$n" ]; then
        echo "usage: wmg <issue-or-pr-number> [workmux add args...]"
        return 1
    fi
    shift

    # one call: the issues endpoint returns PRs too, tagged with .pull_request
    local json
    json=$(gh api "repos/{owner}/{repo}/issues/${n}") || return 1

    if [ -n "$(jq -r '.pull_request // empty' <<<"$json")" ]; then
        workmux add --pr "$n" "$@"
    else
        workmux add "issue-${n}" \
            -p "$(jq -r '"Work on GitHub issue #\(.number): \(.title)\n\n\(.body // "")"' <<<"$json")" \
            "$@"
    fi
}

# remove merged workmux worktrees in the current repo: wmgone [-f]
alias wmgone='workmux rm --gone'

# same, but across EVERY repo workmux tracks: wmgoneall [-f]
function wmgoneall() {
    local repo
    while read -r repo; do
        echo "== ${repo}"
        (cd "${repo}" && workmux rm --gone "$@")
    done < <(workmux ls --all --json | jq -r '.[].project_path' | sort -u)
}
