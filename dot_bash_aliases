alias pir='pip install -r requirements.txt'

# rsync
_rsync_args=(--verbose --progress --human-readable --compress --archive --hard-links --one-file-system)

# http://www.bombich.com/rsync.html
if [[ "$OSTYPE" == darwin* ]] && grep -q 'file-flags' <(rsync --help 2>&1); then
  # _rsync_args+=(--crtimes --acls --xattrs --fileflags --protect-decmpfs --force-change)
  _rsync_args+=(--crtimes --acls --xattrs --fileflags --force-change)
fi

rsync-copy() { rsync "${_rsync_args[@]}" "$@"; }
rsync-move() { rsync "${_rsync_args[@]}" --remove-source-files "$@"; }
rsync-update() { rsync "${_rsync_args[@]}" --update "$@"; }
rsync-sync() { rsync "${_rsync_args[@]}" --update --delete "$@"; }

dry-rsync-copy() { rsync-copy --dry-run "$@"; }
dry-rsync-move() { rsync-move --dry-run "$@"; }
dry-rsync-update() { rsync-update --dry-run "$@"; }
dry-rsync-sync() { rsync-sync --dry-run "$@"; }

if grep -qE 'Microsoft|WSL' /proc/sys/kernel/osrelease 2>/dev/null; then
  alias pbcopy="clip.exe"
  alias pbpaste="powershell.exe -command 'Get-Clipboard' | tr -d '\r'"
elif [[ "$OSTYPE" != darwin* ]]; then
  alias pbcopy="xclip -selection clipboard"
  alias pbpaste="xclip -selection clipboard -o"
fi

# git hooks
git-install-llm-hook() {
    local git_dir
    git_dir=$(git rev-parse --git-dir 2>/dev/null) || { echo "Not a git repository"; return 1; }
    mkdir -p "${git_dir}/hooks"
    ln -sf "${HOME}/.githooks/prepare-commit-msg" "${git_dir}/hooks/prepare-commit-msg"
    echo "Installed prepare-commit-msg hook"
}

# uuidgen lower
if [[ "$OSTYPE" == darwin* ]]; then
  alias uuidgen='uuidgen | tr "[:upper:]" "[:lower:]"'
fi
