# Function to get the absolute path of a file
realpath() {
    [[ $1 = /* ]] && echo "$1" || echo "$PWD/${1#./}"
}

# mise integration — use `use mise` in .envrc to activate mise-managed runtimes
use_mise() {
    direnv_load mise direnv exec
}

# Function to setup a venv and activate (will create one if it doesn't exist)
use_venv() {
    # icase: a case-insensitive file system serves a tracked .VENV as .venv
    if [[ -n $(git ls-files -- ':(icase).venv' 2>/dev/null) ]]; then
        log_error "use_venv: git tracks files under .venv, so its scripts are repository code"
        return 1
    fi
    uv venv --allow-existing || return
    # activate is not sourced: a kept .venv is repository code, and direnv passes only exports to the shell
    export VIRTUAL_ENV="$PWD/.venv"
    PATH_add .venv/bin
    unset PYTHONHOME
}

# Function to set up a Python virtual environment using uv
use_uv() {
    watch_file uv.lock pyproject.toml
    dotenv_if_exists
    use venv || return
    uv sync --quiet
}
