{{- $host := dig "ntfy" "host" "" . | toString -}}
{{- if not (regexMatch "^https://[!-~]+$" $host) }}{{ fail "ntfy.host must be a single-line https:// URL with no control characters; fix it with chezmoi edit-config" }}{{ end -}}
# ntfy-macos configuration file
# local_server_port: 9292  # optional: enable local HTTP server for script-triggered notifications
servers:
  - url: {{ $host }}
    topics:
      - name: macos-cc-high
        icon_symbol: lock.shield
      - name: macos-cc
        icon_symbol: terminal
